# Optional OpenAI-compatible gateway. Leave unset for rules-based mode.
LLM_BASE_URL=https://gateway.example/v1
LLM_API_KEY=
LLM_MODEL=
# Must match one of the prototype's legacy labels; see README.md.
LLM_CASE_MODEL=Qwen 3.6 35B A3B

# Python provider adapters (apps/intelligence). Select a profile in the
# operator-owned providers.local.json; export these variables for the CLI.
# Keys stay server-side and are independent of the prototype LLM_* settings.
OPENROUTER_API_KEY=
HACKATHON_API_KEY=
