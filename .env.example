# Порт веб-интерфейса на компьютере.
WEB_PORT=4173

# Необязательный путь к своему конфигу моделей.
# INTELLIGENCE_CONFIG_FILE=./apps/intelligence/providers.local.json
# Для платных тестов с лимитом $0.20/сутки:
# INTELLIGENCE_CONFIG_FILE=./apps/intelligence/examples/providers.paid.template.json

# Ключи получает только Python-компонент при явном запуске.
OPENROUTER_API_KEY=
HACKATHON_API_KEY=

# Внутренний Python API. Для доступа нужны token И разрешённые tenant IDs.
INTELLIGENCE_PORT=8081
INTELLIGENCE_MODE=baseline
INTELLIGENCE_PROFILE=openrouter
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_TENANTS=demo

# Заполняются после появления PHP Core; worker включается отдельно.
CORE_BASE_URL=http://core:8080
CORE_SERVICE_TOKEN=

# PostgreSQL 17.11: отдельная БД AI/Data. Значения ниже только для localhost-разработки.
# После первого создания volume смена env не меняет пароли БД автоматически.
INTELLIGENCE_DB_PORT=55483
INTELLIGENCE_DB_PASSWORD=local-ai-only
INTELLIGENCE_MIGRATION_DB_PASSWORD=local-migration-only
INTELLIGENCE_DB_BOOTSTRAP_PASSWORD=local-bootstrap-only
INTELLIGENCE_STORAGE_NAMESPACE=main
INTELLIGENCE_DB_POOL_MAX=4
# Для внешнего PostgreSQL задаются отдельно; не используйте DSN/роль Symfony Core.
# INTELLIGENCE_DATABASE_URL=postgresql://intelligence_app:CHANGE_ME@db-host:5432/business_context_ai
# INTELLIGENCE_MIGRATION_DATABASE_URL=postgresql://intelligence_migrator:CHANGE_ME@db-host:5432/business_context_ai
# Для запуска на хосте укажите корень raw-файлов, общий для логических путей хранилищ.
# INTELLIGENCE_STATE_DIR=/absolute/path/to/intelligence/.state
