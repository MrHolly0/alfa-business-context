# Локальные loopback порты; не открывать эти development defaults во внешнюю сеть.
WEB_PORT=4173
CORE_PORT=8090
INTELLIGENCE_PORT=8081
INTELLIGENCE_DB_PORT=55483

# Локальная Core seed запись включена по умолчанию. Только демонстрация.
CORE_SEED_DEMO=1
CORE_INTELLIGENCE_TENANT_ID=core-local

# PostgreSQL 17.11: локальные пароли bootstrap/app/migration ролей.
# Применяются только при первом создании volume; последующая смена env не меняет SQL-роли.
INTELLIGENCE_DB_BOOTSTRAP_PASSWORD=local-bootstrap-only
INTELLIGENCE_DB_PASSWORD=local-ai-only
INTELLIGENCE_MIGRATION_DB_PASSWORD=local-migration-only
CORE_DB_PASSWORD=local-core-only
CORE_MIGRATION_DB_PASSWORD=local-core-migration-only
INTELLIGENCE_STORAGE_NAMESPACE=main
INTELLIGENCE_DB_POOL_MAX=4

# Внутренний service bearer: оставить пустым для однократной генерации либо задать
# локальный seed длиной минимум 24 символа до создания service-auth volume.
INTELLIGENCE_SERVICE_TOKEN=
# API разрешает этот tenant плюс перечисленные дополнительные внутренние tenant IDs.
INTELLIGENCE_TENANTS=

# Провайдерские ключи читает только Python. По умолчанию используется baseline без LLM.
OPENROUTER_API_KEY=
HACKATHON_API_KEY=
INTELLIGENCE_MODE=baseline
INTELLIGENCE_PROFILE=openrouter
# INTELLIGENCE_CONFIG_FILE=./apps/intelligence/examples/providers.template.json

# Только для отдельного Python contract worker/fixture integration.
# Эти переменные не подключают worker к отсутствующему PHP Core job claim API.
CORE_BASE_URL=http://core:8080
CORE_SERVICE_TOKEN=

# Для внешнего AI PostgreSQL задаются собственные AI DSN/credentials; не Core DSN.
# INTELLIGENCE_DATABASE_URL=postgresql://intelligence_app:CHANGE_ME@db-host:5432/business_context_ai
# INTELLIGENCE_MIGRATION_DATABASE_URL=postgresql://intelligence_migrator:CHANGE_ME@db-host:5432/business_context_ai
# Для хостового запуска укажите приватный корень raw-файлов.
# INTELLIGENCE_STATE_DIR=/absolute/path/to/apps/intelligence/.state

# Внешний Core PostgreSQL: отдельные от AI DSN и права; runtime не получает migrator DSN.
# CORE_DATABASE_URL=postgresql://core_app:CHANGE_ME@db-host:5432/business_context_core
# CORE_MIGRATION_DATABASE_URL=postgresql://core_migrator:CHANGE_ME@db-host:5432/business_context_core

# Базовый HTTP-проход Core→AI: ограниченный timeout 5..600 секунд.
CORE_INTELLIGENCE_TIMEOUT_SECONDS=180
# Проверка расписания (30..3600 секунд); сбор каждой компании не чаще раза в час.
CORE_SCHEDULER_INTERVAL=60
