{
  "name": "alfa-business-context-hackathon",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.15.x"
  },
  "scripts": {
    "install:web": "npm ci --prefix apps/web",
    "dev": "docker compose up --build --wait",
    "build": "npm --prefix apps/web run build",
    "validate": "npm --prefix apps/web run validate",
    "test": "docker compose run --build --rm web-test && docker compose run --build --rm intelligence-test"
  }
}
