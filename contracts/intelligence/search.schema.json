{
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "query": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "document_revision_refs": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Revision Refs"
    },
    "role": {
      "anyOf": [
        {
          "enum": [
            "external",
            "bank"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "limit": {
      "default": 8,
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "source_ids",
    "as_of",
    "query"
  ],
  "title": "SearchInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
