{
  "$defs": {
    "CompanyContext": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "industry": {
          "default": "",
          "maxLength": 1000,
          "title": "Industry",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "role": {
          "default": "",
          "maxLength": 1000,
          "title": "Role",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ProvenancedDependency"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/CompanyFact"
          },
          "maxItems": 100,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CompanyContext",
      "type": "object"
    },
    "CompanyFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "text",
        "provenance"
      ],
      "title": "CompanyFact",
      "type": "object"
    },
    "EventInput": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        },
        "source_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source_id",
        "published_at"
      ],
      "title": "EventInput",
      "type": "object"
    },
    "ProvenancedDependency": {
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Dependency Id",
          "type": "string"
        },
        "label": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "hypothesis"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "dependency_id",
        "label",
        "kind",
        "status",
        "provenance"
      ],
      "title": "ProvenancedDependency",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "company": {
      "$ref": "#/$defs/CompanyContext"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventInput"
      },
      "maxItems": 500,
      "title": "Events",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Source Ids",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "company",
    "events",
    "source_ids",
    "as_of"
  ],
  "title": "RankRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
