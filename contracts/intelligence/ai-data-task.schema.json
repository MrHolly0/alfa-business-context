    "DependencyEdge": {
      "additionalProperties": false,
      "description": "One asserted business dependency; edges require traceable evidence and time bounds.",
      "properties": {
        "edge_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
