      "title": "Company Id",
      "type": "string"
    },
    "context_version": {
      "minimum": 1,
      "title": "Context Version",
      "type": "integer"
    },
    "source_policy_version": {
      "minimum": 1,
      "title": "Source Policy Version",
      "type": "integer"
    },
    "operation": {
      "default": "analyze",
      "enum": [
        "collect",
        "analyze",
        "reassess",
        "period",
        "onboard"
      ],
      "title": "Operation",
      "type": "string"
    },
    "trigger": {
      "default": "manual",
      "enum": [
        "scheduled",
        "manual",
        "context_changed",
        "policy_changed",
        "evidence_changed",
        "watch_due"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "knowledge_mode": {
      "default": "as_of",
      "enum": [
        "as_of",
        "latest"
      ],
      "title": "Knowledge Mode",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "source_policy": {
      "$ref": "#/$defs/SourcePolicySnapshot"
    },
    "businesses": {
      "items": {
        "$ref": "#/$defs/BusinessSnapshot"
      },
      "maxItems": 20,
      "title": "Businesses",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Event Ids",
      "type": "array"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeriodSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "watches": {
      "items": {
        "$ref": "#/$defs/WatchCondition"
      },
      "maxItems": 300,
      "title": "Watches",
      "type": "array"
    },
    "watch_observations": {
      "items": {
        "$ref": "#/$defs/WatchObservation"
      },
      "maxItems": 5000,
      "title": "Watch Observations",
      "type": "array"
    },
    "published_assessments": {
      "items": {
        "$ref": "#/$defs/PublishedAssessment"
      },
      "maxItems": 600,
      "title": "Published Assessments",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/AnalysisBudget"
    },
    "data_classification": {
      "default": "confidential",
      "enum": [
        "synthetic",
        "public",
        "confidential"
      ],
      "title": "Data Classification",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "max_events": {
      "default": 10,
      "maximum": 30,
      "minimum": 1,
      "title": "Max Events",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "company_id",
    "context_version",
    "source_policy_version",
    "as_of",
    "source_policy"
  ],
  "title": "DataTask",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
