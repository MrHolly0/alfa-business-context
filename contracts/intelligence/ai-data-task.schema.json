        "max_output_tokens": {
          "default": 2048,
          "maximum": 2048,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 60000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_steps": {
