  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "company-context-v2",
      "default": "company-context-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "industry": {
      "default": "",
      "maxLength": 1000,
      "title": "Industry",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 4000,
      "title": "Description",
      "type": "string"
    },
    "role": {
      "default": "",
      "maxLength": 1000,
      "title": "Role",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/ProvenancedDependency"
      },
      "maxItems": 100,
      "title": "Dependencies",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/CompanyFact"
      },
      "maxItems": 100,
      "title": "Facts",
      "type": "array"
    },
    "activities": {
      "items": {
        "$ref": "#/$defs/CompanyActivity"
      },
      "maxItems": 100,
      "title": "Activities",
      "type": "array"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/CompanyAssertion"
      },
      "maxItems": 200,
      "title": "Assertions",
      "type": "array"
    }
