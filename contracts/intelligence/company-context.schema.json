        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "source_node": {
          "default": "company",
          "maxLength": 256,
          "title": "Source Node",
          "type": "string"
        },
        "target_node": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
