{
  "$defs": {
    "CompanyActivity": {
      "additionalProperties": false,
      "description": "An activity label is retained even when no normalized class is known.",
      "properties": {
        "activity_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Activity Id",
          "type": "string"
        },
        "label": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "normalized_class": {
          "anyOf": [
            {
              "enum": [
                "manufacturing",
                "trade",
                "logistics",
                "software",
                "import",
                "export",
                "agriculture",
                "construction",
                "finance",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Class"
        },
        "status": {
          "default": "confirmed",
          "enum": [
            "confirmed",
            "assumption",
            "contradiction",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "activity_id",
        "label",
        "provenance"
      ],
      "title": "CompanyActivity",
      "type": "object"
    },
