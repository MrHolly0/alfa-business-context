{
  "additionalProperties": false,
  "description": "Explicit finite Core allocation; absent policy means no auto jobs.",
  "properties": {
    "allocation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Allocation Id",
      "type": "string"
    },
    "max_jobs": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Jobs",
      "type": "integer"
    },
    "max_model_calls": {
      "maximum": 3,
      "minimum": 1,
      "title": "Max Model Calls",
      "type": "integer"
    },
    "max_input_tokens": {
      "maximum": 24000,
      "minimum": 1,
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "maximum": 2048,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_total_tokens": {
      "maximum": 60000,
      "minimum": 1,
      "title": "Max Total Tokens",
      "type": "integer"
    },
    "max_steps": {
      "maximum": 12,
      "minimum": 1,
      "title": "Max Steps",
      "type": "integer"
    },
    "cost_reservation_rub": {
      "minimum": 0,
      "title": "Cost Reservation Rub",
      "type": "number"
    },
    "cost_reservation_usd": {
      "minimum": 0,
      "title": "Cost Reservation Usd",
      "type": "number"
    }
  },
  "required": [
    "allocation_id",
    "max_jobs",
    "max_model_calls",
    "max_input_tokens",
    "max_output_tokens",
    "max_total_tokens",
    "max_steps",
    "cost_reservation_rub",
    "cost_reservation_usd"
  ],
  "title": "AutoOptimizationPolicy",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
