{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "job_id",
    "tenant_scope",
    "company_id",
    "trace_id",
    "lease_generation",
    "input_versions",
    "deadline",
    "lease_until",
    "budget",
    "scope",
    "analysis"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis-job-v1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "company_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1
    },
    "input_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_version",
        "source_policy_version",
        "event_versions"
      ],
      "properties": {
        "context_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "event_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "revision"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "lease_until": {
      "type": "string",
      "format": "date-time"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_calls",
        "max_tokens",
        "cost_reservation_rub"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "cost_reservation_rub": {
          "type": "number",
          "minimum": 0
        },
        "cost_reservation_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Required for paid OpenRouter development jobs; independent of RUB reservation"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "document_revision_refs"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 100
        },
        "document_revision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 500
        }
      }
    },
    "analysis": {
      "$ref": "#/$defs/AnalysisRequest"
    }
  },
  "$defs": {
    "AnalysisBudget": {
      "additionalProperties": false,
      "properties": {
        "max_model_calls": {
          "default": 2,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 24000,
          "maximum": 24000,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 2048,
          "maximum": 2048,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 60000,
          "maximum": 60000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_steps": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        }
      },
      "title": "AnalysisBudget",
      "type": "object"
    },
    "CompanyContext": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "industry": {
          "default": "",
          "maxLength": 1000,
          "title": "Industry",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "role": {
          "default": "",
          "maxLength": 1000,
          "title": "Role",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ProvenancedDependency"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/CompanyFact"
          },
          "maxItems": 100,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CompanyContext",
      "type": "object"
    },
    "CompanyFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "text",
        "provenance"
      ],
      "title": "CompanyFact",
      "type": "object"
    },
    "EventInput": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        },
        "source_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source_id",
        "published_at"
      ],
      "title": "EventInput",
      "type": "object"
    },
    "ProvenancedDependency": {
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Dependency Id",
          "type": "string"
        },
        "label": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "hypothesis"
          ],
          "title": "Status",
          "type": "string"
        },
        "provenance": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "dependency_id",
        "label",
        "kind",
        "status",
        "provenance"
      ],
      "title": "ProvenancedDependency",
      "type": "object"
    },
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "analysis-request-v1",
          "default": "analysis-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "company_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "context_version": {
          "minimum": 1,
          "title": "Context Version",
          "type": "integer"
        },
        "source_policy_version": {
          "minimum": 1,
          "title": "Source Policy Version",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "document_revision_refs": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 500,
          "title": "Document Revision Refs",
          "type": "array"
        },
        "company": {
          "$ref": "#/$defs/CompanyContext"
        },
        "event": {
          "$ref": "#/$defs/EventInput"
        },
        "budget": {
          "$ref": "#/$defs/AnalysisBudget"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "tenant_id",
        "company_id",
        "as_of",
        "context_version",
        "source_policy_version",
        "source_ids",
        "company",
        "event"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
