{
  "$defs": {
    "AnalystExample": {
      "additionalProperties": false,
      "description": "Closed example pattern; cannot store company-specific narrative or instructions.",
      "properties": {
        "scenario": {
          "enum": [
            "supply_disruption",
            "regulatory_change",
            "demand_shift",
            "currency_move",
            "capacity_change",
            "data_gap",
            "other"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "focus": {
          "items": {
            "enum": [
              "costs",
              "liquidity",
              "supply",
              "regulation",
              "growth",
              "uncertainty"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Focus",
          "type": "array"
        },
        "check_kind": {
          "enum": [
            "contract_dates",
            "alternative_supplier",
            "order_status",
            "price_formula",
            "region_exposure",
            "regulatory_scope",
            "unknown_data"
          ],
          "title": "Check Kind",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "check_kind"
      ],
      "title": "AnalystExample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Config Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "template_version": {
      "const": "analysis-v2",
      "default": "analysis-v2",
      "title": "Template Version",
      "type": "string"
    },
    "focus": {
      "items": {
        "enum": [
          "costs",
          "liquidity",
          "supply",
          "regulation",
          "growth",
          "uncertainty"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "title": "Focus",
      "type": "array"
    },
    "retrieval_strategy": {
      "default": "balanced",
      "enum": [
        "event_first",
        "dependencies_first",
        "balanced"
      ],
      "title": "Retrieval Strategy",
      "type": "string"
    },
    "answer_style": {
      "default": "balanced",
      "enum": [
        "concise",
        "balanced",
        "detailed"
      ],
      "title": "Answer Style",
      "type": "string"
    },
    "horizon": {
      "default": "quarter",
      "enum": [
        "short",
        "quarter",
        "long"
      ],
      "title": "Horizon",
      "type": "string"
    },
    "role_scope": {
      "default": "any",
      "enum": [
        "any",
        "finance",
        "procurement",
        "executive"
      ],
      "title": "Role Scope",
      "type": "string"
    },
    "industry_scope": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Industry Scope",
      "type": "array"
    },
    "evidence_limit": {
      "default": 16,
      "maximum": 16,
      "minimum": 4,
      "title": "Evidence Limit",
      "type": "integer"
    },
    "max_depth": {
      "default": 2,
      "maximum": 3,
      "minimum": 2,
      "title": "Max Depth",
      "type": "integer"
    },
    "retrieval_expansions": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Retrieval Expansions",
      "type": "array"
    },
    "examples": {
      "items": {
        "$ref": "#/$defs/AnalystExample"
      },
      "maxItems": 3,
      "title": "Examples",
      "type": "array"
    }
  },
  "required": [
    "config_id"
  ],
  "title": "AnalystConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
