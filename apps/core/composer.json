{
  "name": "alfa/business-core",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "symfony/framework-bundle": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
